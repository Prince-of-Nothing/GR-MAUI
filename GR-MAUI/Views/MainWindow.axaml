<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GR_MAUI.ViewModels"
        xmlns:models="using:GR_MAUI.Models"
        x:Class="GR_MAUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="GidiReads"
        Width="800" Height="600"
        Background="#2E1A2A">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <StackPanel Margin="20">
        <TextBlock Text="GidiReads" FontSize="32" FontWeight="Bold" Foreground="#FFE6E6FA" Margin="0,0,0,10"/>

        <Button Content="Load Books" Command="{Binding LoadBooksCommand}" Margin="0,0,0,10" Background="#8B3A62" Foreground="White"/>

        <ProgressBar IsVisible="{Binding IsLoading}" IsIndeterminate="True" Margin="0,0,0,10"/>

        <ListBox ItemsSource="{Binding Books}" Background="#3D1D32" Foreground="#FFE6E6FA">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="models:Book">
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Foreground="#FFE6E6FA"/>
                        <TextBlock Text="{Binding Author}" FontSize="12" Foreground="#D8BFD8"/>
                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#D8BFD8"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</Window>
